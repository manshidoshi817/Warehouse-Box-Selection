# Copy to .env or export these variables. All are optional.
MODEL_PATH=models/best.pt

# Photos: "classic" = colour detector (default), "yolo" = your trained model
PHOTO_ENGINE=classic

# YOLO defaults for photos (dense scenes) and for video (conveyors)
PHOTO_CONF=0.25
PHOTO_IOU=0.5
PHOTO_IMGSZ=960
VIDEO_CONF=0.5
VIDEO_IOU=0.4
VIDEO_IMGSZ=640

MAX_IMAGE_MB=15
MAX_VIDEO_MB=200
JOB_TTL_SECONDS=3600
API_URL=http://localhost:8000
